{
  "inbounds": [
    {
      "type": "hysteria2",
      "tag": "hy2-in",
      "listen": "::",
      "listen_port": 8443,
      "up_mbps": 100,
      "down_mbps": 100,
      "disable_loss_compensation": false,
      "brutal_debug": false,
      "idle_timeout": "30s",
      "keep_alive_period": "10s",
      "stream_receive_window": "8MB",
      "connection_receive_window": "20MB",
      "max_concurrent_streams": 4096,
      "initial_packet_size": 1200,
      "disable_path_mtu_discovery": true,
      "masquerade": "http://127.0.0.1:8080",
      "tls": {
        "certificate_path": "examples/hysteria2-cert.pem",
        "key_path": "examples/hysteria2-key.pem"
      },
      "users": [
        {
          "name": "default",
          "password": "change-this-password"
        }
      ]
    }
  ]
}
