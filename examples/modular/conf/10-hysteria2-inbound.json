{
  "inbounds": [
    {
      "type": "hysteria2",
      "tag": "hy2-in",
      "listen": "::",
      "listen_port": 8443,
      "up_mbps": 100,
      "down_mbps": 100,
      "tls": {
        "certificate_path": "examples/hysteria2-cert.pem",
        "key_path": "examples/hysteria2-key.pem"
      },
      "users": [
        {
          "name": "default",
          "password": "change-this-password"
        }
      ]
    }
  ]
}
