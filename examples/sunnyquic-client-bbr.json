{
  "outbounds": [
    {
      "type": "sunnyquic",
      "tag": "sunnyquic-out",
      "server": "sunny.example.com",
      "server_port": 1443,
      "initial_packet_size": 1300,
      "max_concurrent_streams": 1000,
      "connection_receive_window": 20971520,
      "stream_receive_window": 5000000,
      "keep_alive_period": "10s",
      "idle_timeout": "30s",
      "disable_path_mtu_discovery": false,
      "username": "demo",
      "password": "replace-with-a-long-password",
      "over_stream": false,
      "congestion_control": {
        "type": "bbr"
      },
      "zero_rtt": true,
      "tls": {
        "server_name": "sunny.example.com"
      }
    },
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "final": "sunnyquic-out"
  }
}
