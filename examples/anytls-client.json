{
  "inbounds": [
    {
      "type": "socks",
      "tag": "socks-in",
      "listen": "127.0.0.1",
      "listen_port": 1080
    }
  ],
  "outbounds": [
    {
      "type": "anytls",
      "tag": "anytls-out",
      "server": "127.0.0.1",
      "server_port": 8443,
      "password": "change-this-password",
      "idle_session_check_interval": "30s",
      "idle_session_timeout": "30s",
      "min_idle_session": 0,
      "tls": {
        "server_name": "anytls.example.com",
        "insecure": true
      }
    }
  ],
  "route": {
    "final_outbound": "anytls-out"
  }
}
