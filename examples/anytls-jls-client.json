{
  "inbounds": [
    {
      "type": "socks",
      "tag": "socks-in",
      "listen": "127.0.0.1",
      "listen_port": 1080
    }
  ],
  "outbounds": [
    {
      "type": "anytls",
      "tag": "anytls-jls-out",
      "server": "127.0.0.1",
      "server_port": 8443,
      "password": "change-this-anytls-password",
      "tls": {
        "enable": true,
        "server_name": "localhost",
        "insecure": true,
        "enable_jls": true,
        "jls_username": "change-this-jls-user",
        "jls_password": "change-this-jls-password"
      }
    }
  ],
  "route": {
    "final_outbound": "anytls-jls-out"
  }
}
