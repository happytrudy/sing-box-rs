{
  "inbounds": [
    {
      "type": "shadowquic",
      "tag": "shadowquic-in",
      "listen": "::",
      "listen_port": 443,
      "server_name": "camouflage.example.com",
      "jls_upstream": {
        "addr": "camouflage.example.com:443"
      },
      "users": [
        {
          "name": "demo",
          "password": "replace-with-a-long-password"
        }
      ],
      "tls": {
        "enabled": true,
        "alpn": ["h3"],
        "server_name": "camouflage.example.com",
        "certificate_path": "/etc/sing-box/fullchain.crt",
        "key_path": "/etc/sing-box/private.key"
      }
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "final": "direct"
  }
}
