{
  "inbounds": [
    {
      "type": "shadowquic",
      "tag": "shadowquic-in",
      "listen": "::",
      "listen_port": 443,
      "initial_packet_size": 1300,
      "max_concurrent_streams": 1000,
      "connection_receive_window": 20971520,
      "stream_receive_window": 5000000,
      "keep_alive_period": "10s",
      "idle_timeout": "30s",
      "disable_path_mtu_discovery": false,
      "datagram_receive_buffer_size": 1048576,
      "datagram_send_buffer_size": 1048576,
      "server_name": "camouflage.example.com",
      "jls_upstream": {
        "addr": "camouflage.example.com:443"
      },
      "congestion_control": {
        "type": "brutal",
        "bandwidth_mbps": 100,
        "disable_loss_compensation": false
      },
      "users": [
        {
          "name": "demo",
          "password": "replace-with-a-long-password"
        }
      ]
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "final": "direct"
  }
}
