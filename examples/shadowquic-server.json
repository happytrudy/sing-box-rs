{
  "inbounds": [
    {
      "type": "shadowquic",
      "tag": "shadowquic-in",
      "listen": "::",
      "listen_port": 443,
      "server_name": "camouflage.example.com",
      "jls_upstream": {
        "addr": "camouflage.example.com:443"
      },
      "users": [
        {
          "name": "demo",
          "password": "replace-with-a-long-password"
        }
      ]
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "final": "direct"
  }
}
