{
  "inbounds": [
    {
      "type": "sunnyquic",
      "tag": "sunnyquic-in",
      "listen": "::",
      "listen_port": 1443,
      "initial_packet_size": 1300,
      "max_concurrent_streams": 1000,
      "connection_receive_window": 20971520,
      "stream_receive_window": 5000000,
      "keep_alive_period": "10s",
      "idle_timeout": "30s",
      "disable_path_mtu_discovery": false,
      "users": [
        {
          "name": "demo",
          "password": "replace-with-a-long-password"
        }
      ],
      "congestion_control": {
        "type": "bbr"
      },
      "zero_rtt": true,
      "tls": {
        "enabled": true,
        "server_name": "sunny.example.com",
        "alpn": ["h3"],
        "certificate_path": "/etc/ssl/sunny.example.com/fullchain.pem",
        "key_path": "/etc/ssl/sunny.example.com/privkey.pem"
      }
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "final": "direct"
  }
}
