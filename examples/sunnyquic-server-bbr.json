{
  "inbounds": [
    {
      "type": "sunnyquic",
      "tag": "sunnyquic-in",
      "listen": "::",
      "listen_port": 1443,
      "users": [
        {
          "name": "demo",
          "password": "replace-with-a-long-password"
        }
      ],
      "congestion_control": {
        "type": "bbr"
      },
      "zero_rtt": true,
      "tls": {
        "enabled": true,
        "server_name": "sunny.example.com",
        "alpn": ["h3"],
        "certificate_path": "/etc/ssl/sunny.example.com/fullchain.pem",
        "key_path": "/etc/ssl/sunny.example.com/privkey.pem"
      }
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "final": "direct"
  }
}
